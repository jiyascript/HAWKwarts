    {
      "course_code": "IPRO",
      "course_num": "397",
      "course_combined": "IPRO 397",
      "title": "IPRO Project Techniques",
      "catalog_entry_url": "https://ssb.iit.edu/bnrprd/bwckctlg.p_disp_course_detail?cat_term_in=202710&subj_code_in=IPRO&crse_numb_in=397",
      "course_description": "This course teaches the strategic thinking skills that employers consistently rank as most valuable: problem definition, creative solution generation, and effective implementation. Whether you're pursuing technology, business, science, policy, or any other field, the ability to define problems insightfully, discern quality solutions, and deploy them effectively will amplify your professional impact and help future-proof your career in an era of rapid change. As AI tools automate routine tasks, the human skills that matter most are strategic: identifying which problems deserve solving, evaluating solution quality amid countless options, and navigating the complexity of real-world implementation. These are precisely the capabilities employers seek—and the ones that remain valuable regardless of technological disruption. This course teaches design methods as a practical toolkit for any professional domain, not as a path to becoming a designer. You'll learn systematic approaches to problems that apply whether you're developing software, managing projects, conducting research, building organizations, or creating policy.",
      "learning_objectives": "",
      "catalog_syllabus_url": "",
