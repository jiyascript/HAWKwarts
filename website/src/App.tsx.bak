import { useState, useRef, CSSProperties } from 'react';
import hawkwartsLogo from './assets/hawkwarts-logo.png';

type Phase = 'landing' | 'to-chat' | 'chat' | 'to-landing';
interface Message { from: 'hawkwarts' | 'student'; text: string; }


const SUGGESTED_PROMPTS = [
  'Find courses',
  'Plan my semester',
  'Ask about registration',
];

function sleep(ms: number): Promise<void> {
  return new Promise(r => setTimeout(r, ms));
}

function Disclaimer() {
  return (
    <div className="disclaimer">
      <div className="disclaimer-inner">
        <svg className="disclaimer-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
          viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"
          strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        <p className="disclaimer-text">
          <strong>Always verify important information.</strong> AI can make
          mistakes or produce inaccurate information. We recommend confirming
          final decisions about courses, registration, degree requirements, and
          other academic matters with your{' '}
          <strong>academic advisor</strong> or the appropriate{' '}
          <strong>university office</strong>.
        </p>
      </div>
    </div>
  );
}

export default function App() {
  const [phase, setPhase] = useState<Phase>('landing');
  const [messages, setMessages] = useState<Message[]>([]);
  const [input, setInput] = useState('');
  const messagesEndRef = useRef<HTMLDivElement>(null);

  // Hat image visibility (hidden while flying hat is active)
  const [landingHatHidden, setLandingHatHidden] = useState(false);
  const [chatHawkHidden, setChatHawkHidden] = useState(false);

  // Flying hat: null = not shown; style = position/size/transition
  const [flyStyle, setFlyStyle] = useState<CSSProperties | null>(null);

  // Chat screen fade-in controlled separately for timing
  const [chatVisible, setChatVisible] = useState(false);

  const landingHatRef = useRef<HTMLImageElement>(null);
  const chatHawkRef = useRef<HTMLImageElement>(null);

  const inTransition = phase === 'to-chat' || phase === 'to-landing';

  async function goToChat() {
    if (inTransition || phase === 'chat') return;

    // ── 1. Measure source ──────────────────────────────────
    const src = landingHatRef.current!.getBoundingClientRect();

    // Place flying hat exactly over the landing hat (no transition yet)
    setFlyStyle({
      left: `${src.left}px`,
      top: `${src.top}px`,
      width: `${src.width}px`,
      height: `${src.height}px`,
    });
    setLandingHatHidden(true);
    setPhase('to-chat');

    // Wait one frame so the flying hat renders at src before we start moving
    await sleep(30);

    // ── 2. Measure destination ─────────────────────────────
    const dst = chatHawkRef.current!.getBoundingClientRect();
    setChatHawkHidden(true);

    // ── 3. Fly ─────────────────────────────────────────────
    setFlyStyle({
      left: `${dst.left}px`,
      top: `${dst.top}px`,
      width: `${dst.width}px`,
      height: `${dst.height}px`,
      transition: [
        'left 0.72s cubic-bezier(0.4,0,0.2,1)',
        'top 0.72s cubic-bezier(0.4,0,0.2,1)',
        'width 0.72s cubic-bezier(0.4,0,0.2,1)',
        'height 0.72s cubic-bezier(0.4,0,0.2,1)',
      ].join(', '),
    });

    // Fade in chat UI at ~halfway through flight
    await sleep(300);
    setChatVisible(true);

    // Wait for flight to finish
    await sleep(450);

    // ── 4. Landing bounce ──────────────────────────────────
    setFlyStyle({
      left: `${dst.left}px`,
      top: `${dst.top + 9}px`,
      width: `${dst.width}px`,
      height: `${dst.height}px`,
      transition: 'top 0.11s ease-in',
    });
    await sleep(110);

    setFlyStyle({
      left: `${dst.left}px`,
      top: `${dst.top}px`,
      width: `${dst.width}px`,
      height: `${dst.height}px`,
      transition: 'top 0.14s ease-out',
    });
    await sleep(140);

    // ── 5. Settle ──────────────────────────────────────────
    setChatHawkHidden(false);
    setFlyStyle(null);
    setPhase('chat');
  }

  async function goToLanding() {
    if (inTransition || phase === 'landing') return;

    // ── 1. Measure source (chat hawk) ──────────────────────
    const src = chatHawkRef.current!.getBoundingClientRect();

    setFlyStyle({
      left: `${src.left}px`,
      top: `${src.top}px`,
      width: `${src.width}px`,
      height: `${src.height}px`,
    });
    setChatHawkHidden(true);
    setPhase('to-landing');

    await sleep(30);

    // ── 2. Measure destination (landing hat) ───────────────
    const dst = landingHatRef.current!.getBoundingClientRect();
    setLandingHatHidden(true);

    // ── 3. Fly back ────────────────────────────────────────
    setFlyStyle({
      left: `${dst.left}px`,
      top: `${dst.top}px`,
      width: `${dst.width}px`,
      height: `${dst.height}px`,
      transition: [
        'left 0.65s cubic-bezier(0.4,0,0.2,1)',
        'top 0.65s cubic-bezier(0.4,0,0.2,1)',
        'width 0.65s cubic-bezier(0.4,0,0.2,1)',
        'height 0.65s cubic-bezier(0.4,0,0.2,1)',
      ].join(', '),
    });

    // Fade out chat UI
    await sleep(200);
    setChatVisible(false);

    await sleep(480);

    // ── 4. Restore landing hat ─────────────────────────────
    setLandingHatHidden(false);
    setFlyStyle(null);
    setPhase('landing');
  }

  function sendMessage() {
    const text = input.trim();
    if (!text) return;
    setMessages(prev => [...prev, { from: 'student', text }]);
    setInput('');
  }

  function handleKeyDown(e: React.KeyboardEvent) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  }

  // Derived opacity values
  const landingScreenOpacity = (phase === 'landing' || phase === 'to-landing') ? 1 : 0;
  const chatScreenOpacity = chatVisible || phase === 'chat' ? 1 : 0;

  return (
    <div className="app-shell">

      {/* ── Flying hat overlay ─────────────────────────── */}
      {flyStyle && (
        <img
          src={hawkwartsLogo}
          alt=""
          aria-hidden="true"
          className="flying-hat"
          style={flyStyle}
        />
      )}

      {/* ── Landing screen ────────────────────────────── */}
      <div
        className="page-root"
        style={{
          opacity: landingScreenOpacity,
          transition: inTransition ? 'opacity 0.45s ease' : 'none',
          pointerEvents: phase === 'landing' ? 'auto' : 'none',
        }}
      >
        <main className="hero">
          <div className="hero-inner">
            <button
              className="logo-btn"
              aria-label="Enter HAWKwarts"
              onClick={goToChat}
              disabled={inTransition}
            >
              <img
                ref={landingHatRef}
                src={hawkwartsLogo}
                alt="HAWKwarts wizard hat logo"
                className="logo-img"
                style={{ opacity: landingHatHidden ? 0 : 1 }}
              />
              <span className="logo-hint">Click to start</span>
            </button>

            <div className="hero-text">
              <h1 className="title">HAWKwarts</h1>
              <p className="description">
                Your AI guide to campus life — helping with registration, courses,
                professors, and everyday questions. Reliable answers, without the run
                <svg
                  className="runaround-svg"
                  viewBox="0 0 92 32"
                  xmlns="http://www.w3.org/2000/svg"
                  role="img"
                  aria-label="around"
                  style={{ overflow: 'visible' }}
                >
                  <defs>
                    <path id="runaround-arc" d="M 3,5 Q 46,25 89,5" />
                  </defs>
                  <text fontFamily="Georgia, serif" fontSize="16" fill="#1a1a1a">
                    <textPath href="#runaround-arc" startOffset="50%" textAnchor="middle">
                      a r o u n d .
                    </textPath>
                  </text>
                </svg>
              </p>
            </div>
          </div>
        </main>
        <Disclaimer />
      </div>

      {/* ── Chat screen (fixed overlay) ───────────────── */}
      <div
        className="page-root chat-screen-overlay"
        style={{
          opacity: chatScreenOpacity,
          transition: inTransition ? 'opacity 0.45s ease' : 'none',
          pointerEvents: phase === 'chat' ? 'auto' : 'none',
        }}
      >
        <header className="chat-header">
          <span className="chat-header-title">Illinois Tech</span>
          <div className="chat-header-divider" />
        </header>

        <main className="chat-main">
          <div className="chat-wrapper">
            <img
              ref={chatHawkRef}
              src={hawkwartsLogo}
              alt="HAWKwarts"
              className="chat-hawk"
              style={{ opacity: chatHawkHidden ? 0 : 1 }}
            />
            <div className="chat-container">
              <div className="chat-messages">
                {messages.length === 0 ? (
                  <div className="chat-empty">
                    <p className="chat-empty-heading">What can I help you with?</p>
                    <p className="chat-empty-sub">Ask about courses, registration, degree planning, or campus life.</p>
                    <div className="chat-suggestions">
                      {SUGGESTED_PROMPTS.map(prompt => (
                        <button
                          key={prompt}
                          className="chat-suggestion"
                          onClick={() => setInput(prompt)}
                        >
                          {prompt}
                        </button>
                      ))}
                    </div>
                  </div>
                ) : (
                  messages.map((msg, i) => (
                    <div key={i} className={`message message-${msg.from}`}>
                      <span className="message-label">
                        {msg.from === 'hawkwarts' ? 'HAWKwarts' : 'You'}
                      </span>
                      <p className="message-text">{msg.text}</p>
                    </div>
                  ))
                )}
                <div ref={messagesEndRef} />
              </div>
              <div className="chat-input-row">
                <input
                  className="chat-input"
                  type="text"
                  placeholder="Ask HAWKwarts..."
                  value={input}
                  onChange={e => setInput(e.target.value)}
                  onKeyDown={handleKeyDown}
                />
                <button className="chat-send-btn" onClick={sendMessage} aria-label="Send message">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" strokeWidth="2.5" strokeLinecap="round"
                    strokeLinejoin="round" aria-hidden="true">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </main>

        <Disclaimer />

        <button className="chat-back-btn" onClick={goToLanding}>
          &#8592; Back
        </button>
      </div>
    </div>
  );
}
